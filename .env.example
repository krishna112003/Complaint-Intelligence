# Complaint Intelligence & LLM Evaluation Pipeline
# Copy this file to .env and fill in your values.

# ---- LLM Provider (free-tier) ----
# Default: Local Ollama (no key needed, just run 'ollama serve')
# Set active_profile in configs/llm.yaml to switch providers.

# Optional: Groq free tier (https://console.groq.com/keys)
# GROQ_API_KEY=gsk_your-free-key-here

# Optional: Google AI Studio Gemini free tier (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your-free-gemini-key-here

# Optional: OpenRouter free models (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-free-your-key-here

# ---- MLflow ----
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
